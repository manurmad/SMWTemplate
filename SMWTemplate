//define challenge trigger conditions
INSTANT = 0 // use the goal timer (byte(0x1493) -> timer that counts down from 0xff when you finish level)
NORMAL_EXIT = 1 // use dd5 = 1
SECRET_EXIT = 2 // use dd5 = 2
MIDWAY = 3 // use 13ce = 1
BOSS = 4 // use 13c6 > 0
SWITCH = 5 // use 13d2 > 0
ROOM = 6 // for when a challenge requires entering a specific room

//Optional function for challenges. Creates the starting conditions for a challenge to prime, such as starting from the beginning or from a checkpoint. 
//Be sure to edit the FAST_RETRY constant for this to work properly with hacks that use the fast retry system.
//The optional "spawns" array contains the checkpoint ID(s) for which the challenge to start. By default it is [0] which means start from the beginning.
//-If [-1] is passed in for the spawns array, the challenge will start upon entering the level from ANY point (the beginning or the checkpoint).
//-If [1] is passed in for the spawns array, the challenge will start upon starting from the checkpoint only.
//-If [0, 5, 8] is passed in, the challenge will start upon starting the level from the beginning OR starting from the fast retry spawn IDs 5 or 8.
function Start(img, spawns = [0])
{

    if (dictionary_contains_key(level_images, img))
        image = level_image
    else
        image = room_image
    
    if (length(spawns) > 0 && spawns[0] == -1) //-1 means the start is anywhere in the level
            return tally(1, once(image == img && prev(!InLevel()) && InLevel()), Respawned() && image == img)
    
    if (FAST_RETRY == 0)
         if (length(spawns)) //start the challenge at the beginning of the level by default
            return tally(1, once(level_image == lvl && prev(!InLevel()) && InLevel() && start_midway == 0), Respawned() && level_image == lvl && start_midway == 0)
        else 
            return tally(1, once(level_image == lvl && prev(!InLevel()) && InLevel() && start_midway == 0x40), Respawned() && level_image == lvl && start_midway == 0x40)    
    
    if (FAST_RETRY == 1)
        if (length(spawns) == 1) //if the array only contains one respawn point ID
            return tally(1, once(image == img && prev(!InLevel()) && InLevel() && fast_retry_cp == spawns[0]), Respawned() && level_image == img && fast_retry_cp == spawns[0])
        else //if the array contains multiple respawn point IDs
            return tally(1, once(image == img && prev(!InLevel()) && InLevel() && any_of(spawns, i => fast_retry_cp == i)), Respawned() && image == img && any_of(spawns, i => fast_retry_cp == i))
        
}

//Function for the trigger conditions of an achievement.
//TODO: Document this function and add more conditions such as for moons, dragon coins, and groups of exits.
function Goal(input, arr = []) { 
    
    if (input == INSTANT)
        return goal == 0xff && prev(goal)==0x00
    if (input == NORMAL_EXIT)
        return prev(exit)==0x00 && exit == 1
    if (input == SECRET_EXIT)
        return prev(exit)==0x00 && exit == 2
    if (input == BOSS)
        return prev(cutscene) == 0 && cutscene > 0
    if (input == SWITCH)
        return prev(pressed_big_switch) == 0 && pressed_big_switch == 1  
    if (input == ROOM)
        return Entered_Room(arr[0])
    if (input == MIDWAY)
        if (FAST_RETRY == 0)
            return midway==1 && prev(midway)==0 && game_state == 0x14
        if (FAST_RETRY == 1)
            if length(arr) == 0
                return prev(fast_retry_cp) != fast_retry_cp && prev(level_image) == level_image 
            if length(arr) == 1
                return prev(fast_retry_cp) != arr[0] && fast_retry_cp == arr[0] && prev(level_image) == level_image
            else
                return (any_of(arr, i => fast_retry_cp == i)) && prev(level_image) == level_image

}

